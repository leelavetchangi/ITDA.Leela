{
  "info": {
    "name": "Gym Membership System API",
    "description": "Phase 8 collection covering all 17 API endpoints in dependency order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "planId", "value": "" },
    { "key": "memberId", "value": "" },
    { "key": "testEmail", "value": "" },
    { "key": "testMemberEmail", "value": "" },
    { "key": "joinDate", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Register",
          "event": [{ "listen": "prerequest", "script": { "exec": ["pm.collectionVariables.set('testEmail', `postman-${Date.now()}@example.com`);"], "type": "text/javascript" } }, { "listen": "test", "script": { "exec": ["pm.test('Status is 201', () => pm.response.to.have.status(201));", "const json = pm.response.json();", "pm.collectionVariables.set('token', json.token);", "pm.test('Token and user returned', () => pm.expect(json).to.have.property('token').and.to.have.property('user'));"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"StrongPass123\"\n}" }, "url": "{{baseUrl}}/auth/register" }
        },
        {
          "name": "2. Login",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('token', pm.response.json().token);"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"StrongPass123\"\n}" }, "url": "{{baseUrl}}/auth/login" }
        },
        {
          "name": "3. Me",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('Password is not returned', () => pm.expect(pm.response.json().user).to.not.have.property('password'));"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{baseUrl}}/auth/me" }
        }
      ]
    },
    {
      "name": "Plans",
      "item": [
        {
          "name": "4. Create plan",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 201', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('planId', pm.response.json()._id);"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman 30 Day Plan\",\n  \"durationInDays\": 30,\n  \"price\": 49.99\n}" }, "url": "{{baseUrl}}/plans" }
        },
        {
          "name": "5. List plans",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('Pagination shape exists', () => pm.expect(pm.response.json()).to.have.all.keys('data', 'total', 'page', 'totalPages'));"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{baseUrl}}/plans?page=1&limit=10" }
        },
        {
          "name": "6. Get plan",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{baseUrl}}/plans/{{planId}}" }
        },
        {
          "name": "7. Update plan",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('Duration updated', () => pm.expect(pm.response.json().durationInDays).to.eql(31));"], "type": "text/javascript" } }],
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman 31 Day Plan\",\n  \"durationInDays\": 31,\n  \"price\": 54.99\n}" }, "url": "{{baseUrl}}/plans/{{planId}}" }
        }
      ]
    },
    {
      "name": "Members and attendance",
      "item": [
        {
          "name": "8. Create member",
          "event": [{ "listen": "prerequest", "script": { "exec": ["pm.collectionVariables.set('joinDate', new Date().toISOString().slice(0, 10));", "pm.collectionVariables.set('testMemberEmail', `member-${Date.now()}@example.com`);"], "type": "text/javascript" } }, { "listen": "test", "script": { "exec": ["pm.test('Status is 201', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('memberId', pm.response.json()._id);", "pm.test('Member is active', () => pm.expect(pm.response.json().status).to.eql('active'));"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Member\",\n  \"phone\": \"555-0800\",\n  \"email\": \"{{testMemberEmail}}\",\n  \"planId\": \"{{planId}}\",\n  \"joinDate\": \"{{joinDate}}\"\n}" }, "url": "{{baseUrl}}/members" }
        },
        {
          "name": "9. List members",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('Pagination shape exists', () => pm.expect(pm.response.json()).to.have.all.keys('data', 'total', 'page', 'totalPages'));"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{baseUrl}}/members?page=1&limit=10" }
        },
        {
          "name": "10. Get member",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{baseUrl}}/members/{{memberId}}" }
        },
        {
          "name": "11. Update member",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('Name updated', () => pm.expect(pm.response.json().name).to.eql('Postman Member Updated'));"], "type": "text/javascript" } }],
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Member Updated\",\n  \"phone\": \"555-0801\",\n  \"email\": \"{{testMemberEmail}}\",\n  \"planId\": \"{{planId}}\",\n  \"joinDate\": \"{{joinDate}}\"\n}" }, "url": "{{baseUrl}}/members/{{memberId}}" }
        },
        {
          "name": "12. Renew member",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('Member remains active', () => pm.expect(pm.response.json().status).to.eql('active'));"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{baseUrl}}/members/{{memberId}}/renew" }
        },
        {
          "name": "13. Expiring members",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('Expiring response has data', () => pm.expect(pm.response.json()).to.have.property('data'));"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{baseUrl}}/members/expiring?days=365" }
        },
        {
          "name": "14. Check in",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 201', () => pm.response.to.have.status(201));", "pm.test('Attendance member matches', () => pm.expect(pm.response.json().memberId._id).to.eql(pm.collectionVariables.get('memberId')));"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "body": { "mode": "raw", "raw": "{\n  \"memberId\": \"{{memberId}}\"\n}" }, "url": "{{baseUrl}}/checkin" }
        },
        {
          "name": "15. Attendance history",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('Attendance pagination exists', () => pm.expect(pm.response.json()).to.have.all.keys('data', 'total', 'page', 'totalPages'));"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{baseUrl}}/members/{{memberId}}/attendance?page=1&limit=10" }
        },
        {
          "name": "16. Delete member",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }],
          "request": { "method": "DELETE", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{baseUrl}}/members/{{memberId}}" }
        },
        {
          "name": "17. Delete plan",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }],
          "request": { "method": "DELETE", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{baseUrl}}/plans/{{planId}}" }
        }
      ]
    }
  ]
}
